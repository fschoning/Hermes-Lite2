			(at 575.31 44.45 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Note" "SOT-23, pin 1 gate / 2 source / 3 drain. Vgs(th) 1.45 V MAX, so a 3.3 V strap drives it with 1.85 V of margin. DO NOT substitute the cheaper 2N7002: its threshold is specified up to 2.5 V. A logic inverter was rejected on cost alone - no single-gate logic part of any family is a Basic part in JLCPCB's library. DESIGN_NOTES.md 2.1."
			(at 575.31 44.45 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Description" "The ROLE_N inverter, built from one N-channel MOSFET: gate on ROLE, source to ground, drain on ROLE_N, loaded by the 10 k pull-up that is already fitted. This one part is what makes the complement a property of the circuit instead of a property of the user remembering to move two shunts the same way"
			(at 575.31 44.45 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
