		(property "MFR" "PM254V-12-10P-H85 (LCSC C492399) or any 2.54 mm 2x5 vertical female socket"
			(at 946.15 222.25 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Note" "NOT PLACED BY JLCPCB - hand soldered on the underside. THE TOLERANCE WARNING: this is the third rigid 2.54 mm socket on one board, 54.19 mm from DB1, and HL2_MECHANICAL_ENVELOPE.md 12.2 puts the worst-case misalignment at CN1 relative to DB1 at about +/-0.8 mm against the +/-0.35 mm a 2.54 mm socket takes comfortably. If it will not engage, LEAVE J4 OFF and run a flying 10-way IDC ribbon from CN1 to J5 instead - J5 carries the same ten nets and needs no other change."
			(at 946.15 222.25 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
