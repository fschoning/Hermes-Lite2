			(at 165.1 358.14 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "LCSC" "C81461"
			(at 165.1 358.14 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "MFR" "SN74AVC4T245PWR"
			(at 165.1 358.14 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Note" "Both DIR to VCCA (A->B), both OE* to GND. The two enable channels are static levels, not signals. Neither reaches its buffer directly any more: JTAG_EN_RAW_N passes Q3 and AUXIO_EN_N passes Q4 and Q1, both gated by LINK_ALIVE, because stock HL2 gateware drives FPGA pins 72 and 80 LOW. Each enable is pulled UP at BOTH ends - to +2V5 on the HL2 side and to +3V3 on the logic side - so a missing part, an unpowered part, an unconfigured FPGA or an open HL2 jumper J25 all leave the feature DISABLED."
			(at 165.1 358.14 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Description" "4-bit dual-supply translator, VCCA 2.5 V / VCCB 3.3 V. Port 1 is the auxiliary transmit pair - clock and data in one port so they share a skew. Port 2 carries the two ENABLE LEVELS the gateware controls: JTAG over the cable and the AUXIO drive direction, both active LOW, both DC"
			(at 165.1 358.14 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
