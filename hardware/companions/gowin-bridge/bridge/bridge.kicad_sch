			(at 610.87 37.87 0)
			(effects (font (size 1.27 1.27)) (justify left)))
		(property "Footprint" "gowin-bridge:TSSOP-16_4.4x5mm_P0.65mm"
			(at 610.87 54.61 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "LCSC" "C81461"
			(at 610.87 54.61 0)
