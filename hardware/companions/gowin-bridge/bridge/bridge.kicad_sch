		(property "Footprint" "gowin-bridge:PinSocket_2x18_P2.54mm_Vertical"
			(at 162.56 59.69 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "MFR" "SCHEME 1: Hong Cheng HC-PZ254-11.5L-2X18PZ, LCSC C41376109, 2x18 male (3.0 mm tail, 2.5 mm insulator, 6.0 mm mating), fitted UPSIDE DOWN: the 3.0 mm end goes down into the dock socket, the 6.0 mm end up through the adapter, soldered on top and clipped. SCHEME 2: hanxia HX PM2.54-2x18P ZC, LCSC C42372542, 2x18 female, 8.5 mm body, on the adapter underside"
			(at 162.56 59.69 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Note" "NOT PLACED BY JLCPCB. J14 positions 1-4 lie under the SlimSAS connector and are NOT fitted on either side of the stack. Position 11 (pin 7 here) is the dock 5 V rail and is left unconnected; position 12 (pin 8 here) is the only ground. Positions 5-8 are PMOD0 and 21-28 are PMOD1 and the camera: nothing may be plugged into either PMOD socket or the camera connector while fitted. Dock side, scheme 1: kinghelm KH-2.54FH-2X18P-H5.0, LCSC C55160396, 2x18 female, 5.0 mm body, soldered into dock J14 positions 5-40. Dock side, scheme 2: Hong Cheng HC-PZ254-11.5L-2X18PZ, LCSC C41376109, 2x18 male, 2.5 mm insulator, soldered into dock J14 positions 5-40."
			(at 162.56 59.69 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Description" "Mates Tang Mega 138K dock J14 positions 5-40 (FPGA Bank 4). Pin k of this part is J14 position k+4. HAND SOLDERED, bottom side"
			(at 162.56 59.69 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
