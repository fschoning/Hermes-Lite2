		(property "MFR" "SN74AVC4T245PWR"
			(at 610.87 54.61 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Note" "Both DIR to VCCA (A->B), both OE* to GND. The two enable channels are static levels, not signals. Each enable is pulled UP at BOTH ends - to +2V5 on the HL2 side and to +3V3 on the logic side - so a missing part, an unpowered part, an unconfigured FPGA or an open HL2 jumper J25 all leave the feature DISABLED."
			(at 610.87 54.61 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Description" "4-bit dual-supply translator, VCCA 2.5 V / VCCB 3.3 V. Port 1 is the auxiliary transmit pair - clock and data in one port so they share a skew. Port 2 carries the two ENABLE LEVELS the gateware controls: JTAG over the cable and the AUXIO drive direction, both active LOW, both DC"
			(at 610.87 54.61 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(pin "1"
			(uuid "2609261d-ef0e-a6cf-ff85-9c1791209bcc"))
		(pin "2"
			(uuid "573ea9da-2b49-5bd9-7c5b-c79bd144bce6"))
		(pin "3"
