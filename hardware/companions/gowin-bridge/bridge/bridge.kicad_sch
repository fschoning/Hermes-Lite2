			(at 144.78 41.91 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "MFR" "2.54 mm 2x3P female header, VERTICAL (top entry). LCSC stocks no vertical 2x3 socket - buy a 2x4 and cut it down, or source outside LCSC"
			(at 144.78 41.91 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Note" "NOT PLACED BY JLCPCB. NOTE THE ORDER: pin 5 = FPGA PIN_89 (auxiliary clock in) and pin 6 = FPGA PIN_88 (reverse clock in). rev A of PINMAP.md had these two transposed; check_netlist.py now asserts it. Also: HL2 R17, the optional 100 R LVDS termination between DB12 pins 5 and 6, MUST NOT BE POPULATED - it shorts the two nets together through 100 R."
			(at 144.78 41.91 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Description" "Mates HL2 DB12. HAND SOLDERED, bottom side"
			(at 144.78 41.91 0)
