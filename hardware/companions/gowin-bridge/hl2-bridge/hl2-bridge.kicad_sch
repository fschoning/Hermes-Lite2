			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Description" "4-bit dual-supply level translator, VCCA 3.3 V / VCCB 2.5 V. Port 1 (always on) = the IN clock into PIN_88 and the ROLE level into PIN_89. Port 2 = AUX group G2 toward the HL2, enabled only in ROLE A"
			(at 170.18 140.97 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
