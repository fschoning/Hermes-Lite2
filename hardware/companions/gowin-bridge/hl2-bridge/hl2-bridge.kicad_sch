			(at 59.69 49.53 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Note" "NOT PLACED BY JLCPCB - hand soldered, bottom side. Clip the tails of positions 1,2,3,4,5,6,9,11,15,17 FLUSH before fitting: those ten carry the link and must not be passed up to a stacked board. The ten that remain are 7,8 (Vlvds), 10,12 (CW/PTT), 13,14 (GND), 16,18 (SCL1/SDA1) and 19,20 (+3V3)."
			(at 59.69 49.53 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
		(property "Description" "Mates HL2 DB1. HAND SOLDERED - LCSC stocks no long-tail 2x10 socket at all (all seven of their 2x10 female listings are ordinary ~3.2 mm pins), so this is not a JLCPCB assembly line item. The ordinary vertical socket LCSC C42431860 fits the same holes if you do not want to stack anything"
			(at 59.69 49.53 0)
			(effects (font (size 1.27 1.27)) (hide yes)))
